# Environment variables — DO NOT commit this file to GitHub
# Set these values in GoDaddy cPanel → Setup Node.js App → Environment Variables instead

GOOGLE_API_KEY=your_google_api_key_here
PLACE_ID=your_google_place_id_here

# Comma-separated list of allowed origins (your HubSpot domains)
# e.g. https://www.yourdomain.com,https://12345678.hs-sites.com
ALLOWED_ORIGINS=https://www.yourdomain.com,https://12345678.hs-sites.com

PORT=3000
